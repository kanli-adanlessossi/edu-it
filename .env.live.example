# Template for .env.live (git-ignored), loaded by tools/live-run-env.ps1:
#   Copy-Item .env.live.example .env.live ; then edit; then  . .\tools\live-run-env.ps1
# Only the credential is required; the other values below are the ADR 0007 defaults and
# can be deleted. Set exactly one of the two credential variables. Never commit real keys.

# Key lookup when neither credential variable is set: SecretManagement vault secret, then Windows
# Credential Manager entry (both named edu-it-llm-provider-api-key; override with -SecretName), then a
# hidden prompt. Store it once, never in a file:  .\tools\live-run-env.ps1 -StoreKey
# Check everything before task 28.2:  .\tools\check_live_prereqs.ps1 [-Fetch] [-SkipTests]

# Long-term Bedrock key for local use (expiry 90 days at most). Leave unset to use a stored key:
# LLM_PROVIDER_API_KEY=

# OR, on AWS: name of the Secrets Manager secret holding the short-term key.
# LLM_PROVIDER_API_KEY_SECRET_ID=

# Non-secret defaults (bare base URL, no path; never a global.* model id):
# LLM_PROVIDER_BACKEND=live
# LLM_PROVIDER_VENDOR=bedrock_claude
# LLM_PROVIDER_ENDPOINT=https://bedrock-runtime.eu-central-1.amazonaws.com
# LLM_PROVIDER_ALLOWED_HOSTS=bedrock-runtime.eu-central-1.amazonaws.com
# LLM_MODEL_GENERATION=eu.anthropic.claude-sonnet-4-6
# LLM_MODEL_VERIFIER=eu.anthropic.claude-sonnet-4-6
# LLM_PRICES=eu.anthropic.claude-sonnet-4-6=300:1500
