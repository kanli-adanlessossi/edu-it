{
  "name": "@edu-it/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EDU-IT Next.js App Router UI (/fr and /en route trees).",
  "scripts": {
    "generate:client": "node scripts/build-client.mjs",
    "generate:lab-config": "node scripts/lab-config.mjs",
    "copy:monaco": "node scripts/copy-monaco.mjs",
    "build": "node scripts/build-client.mjs && node scripts/lab-config.mjs && node scripts/copy-monaco.mjs && next build --webpack",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "node scripts/lab-config.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/lab-config.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.e2e.config.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@monaco-editor/loader": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "minimatch": "11.0.3"
  }
}
