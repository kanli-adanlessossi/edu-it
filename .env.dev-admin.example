# Local dev admin seeded by start.sh / start.bat (tools/dev_seed.py).
# Copy to .env.dev-admin (git-ignored) and fill in; values are read literally, so a "$" or "#"
# in the password needs no quoting. Leave the file out to skip seeding.
# Sign-up requires 12-128 characters; seeding bypasses that check, but a password reset will not.
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=change-me-please
