# EDU-IT environment template (Req 2.5, 2.6).
#
# This file enumerates every environment variable read by apps/web, apps/api,
# and apps/worker, one variable per line. Every value here is a NON-SENSITIVE
# PLACEHOLDER: this template contains no real secret, credential, token, or
# production value. Copy it to `.env` and fill in real values locally; `.env`
# itself is git-ignored and must never be committed.
#
# Business numbers (verification-link TTL, reset-link TTL, session duration,
# OAuth link-confirmation window, sign-in rate-limit threshold and window, the
# password policy) are NOT environment variables — they live as business
# constants in packages/domain/config.py per the design — so they are
# intentionally absent here.
#
# Variables are grouped by the service that reads them. Shared data-store and
# mailer settings are read by more than one service, as noted.

# =============================================================================
# Shared runtime (read by apps/api and apps/worker)
# =============================================================================

# Deployment environment. One of: development, test, production.
# The Test_Clock and the LLMProvider fake are enabled only outside production.
EDU_IT_ENV=development

# Structured-log verbosity. One of: debug, info, warning, error.
LOG_LEVEL=info

# =============================================================================
# Shared data stores (read by apps/api and apps/worker)
# =============================================================================

# PostgreSQL system-of-record connection URL.
DATABASE_URL=postgresql://edu_it:change-me@localhost:5432/edu_it

# Redis connection URL. Backs both the task queue (ADR 0003) and the
# server-side session / ephemeral state store (ADR 0004).
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Shared Mailer (SMTP in prod, console in dev) — read by apps/api and apps/worker
# =============================================================================

# Mailer backend. One of: console, smtp. Development uses console.
MAILER_BACKEND=console

# SMTP settings — used only when MAILER_BACKEND=smtp.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=mailer-user
SMTP_PASSWORD=change-me
SMTP_USE_TLS=false

# From-address applied to outbound mail (verification, reset, notifications).
MAIL_FROM_ADDRESS=no-reply@example.test

# =============================================================================
# Shared LLMProvider (ahead-of-time generation) — read by apps/api and apps/worker
# =============================================================================

# LLMProvider backend. One of: fake, replay, live.
#   test:        fake and replay allowed, live refused (no model network in tests)
#   development: all allowed
#   production:  live only (fake and replay refused)
# The settings below this line are read only by the live backend, except
# LLM_FIXTURE_DIR (replay and record) and ADVISOR_HANDLE_KEY (path advisor).
LLM_PROVIDER_BACKEND=fake
# Name of the registered vendor adapter. Optional when exactly one is registered.
LLM_PROVIDER_VENDOR=
# HTTPS endpoint of the provider (EU residency, ADR 0007).
LLM_PROVIDER_ENDPOINT=
LLM_PROVIDER_API_KEY=change-me
# Production: name of the AWS Secrets Manager secret that holds the key (read on first use and
# re-read once after a 401/403). Mutually exclusive with LLM_PROVIDER_API_KEY: set exactly one.
# When you set it, remove LLM_PROVIDER_API_KEY above.
# LLM_PROVIDER_API_KEY_SECRET_ID=
# Comma-separated hosts a response may come from (EU endpoints only).
LLM_PROVIDER_ALLOWED_HOSTS=
# Models for drafting and for the independent Verifier.
LLM_MODEL_GENERATION=
LLM_MODEL_VERIFIER=
# Cents per million tokens as model=input:output pairs, comma-separated.
# Example: LLM_PRICES=model-a=300:1500,model-b=100:500
LLM_PRICES=
# Directory of recorded fixtures read by the replay backend.
LLM_FIXTURE_DIR=evals/fixtures
# Write live exchanges to LLM_FIXTURE_DIR as fixtures (true or false).
LLM_RECORD=false
# Secret key of the pseudonymous learner handles sent to the path advisor.
ADVISOR_HANDLE_KEY=change-me

# =============================================================================
# Shared ObjectStorage (GDPR exports, lab artifacts) — read by apps/api and apps/worker
# =============================================================================

# Object-storage backend. One of: memory, filesystem. Dev uses memory.
OBJECT_STORAGE_BACKEND=memory
# Root directory of the filesystem backend; required when the backend is filesystem.
OBJECT_STORAGE_ROOT=
OBJECT_STORAGE_BUCKET=edu-it-local
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_REGION=us-east-1

# =============================================================================
# apps/api (FastAPI boundary)
# =============================================================================

# HTTP bind host and port for the API service.
API_HOST=0.0.0.0
API_PORT=8000

# Public base URL of the API, used to build absolute links in emails.
API_BASE_URL=http://localhost:8000

# Public base URL of the web app, used to build learner-facing links in emails.
WEB_BASE_URL=http://localhost:3000

# Domain attribute of the session cookie and the csrf_token cookie. Empty means
# a host-only cookie (fine on localhost).
# The Web_App and the API_Service must be deployed same-site: one registrable
# domain (for example app.example.com and api.example.com with
# COOKIE_DOMAIN=example.com) or localhost. Cross-site deployments are unsupported.
COOKIE_DOMAIN=

# Secret used to sign CSRF tokens and opaque session references.
API_SECRET_KEY=change-me-dev-secret

# Default locale used when a request locale is absent or unsupported.
# One of: fr, en.
DEFAULT_LOCALE=en

# GitHub OAuth application credentials and callback.
GITHUB_OAUTH_CLIENT_ID=change-me
GITHUB_OAUTH_CLIENT_SECRET=change-me
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/v1/auth/github/callback

# =============================================================================
# apps/worker (task-queue consumer)
# =============================================================================

# HTTP bind host and port for the worker's health/readiness endpoints.
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=8001

# =============================================================================
# apps/web (Next.js App Router UI)
# =============================================================================

# HTTP listen port for the web server.
WEB_PORT=3000

# Base URL the generated client uses to reach the API from the browser.
# Exposed to the browser bundle, so it uses the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# Default locale for first-visit visitors with no saved preference.
# One of: fr, en.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Show the "Sign in with GitHub" link on the sign-in page. Set to true only when
# the API has GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET, and
# GITHUB_OAUTH_CALLBACK_URL configured. Exposed to the browser bundle.
NEXT_PUBLIC_GITHUB_SIGN_IN_ENABLED=false
